--[[
    Wind UI Library v2 (Resizable + Theme)
    Uso:
    local WindUI = loadstring(game:HttpGet("TU_URL"))()

    local Window = WindUI:CreateWindow({
        Title      = "Mi UI",
        Size       = UDim2.fromOffset(340, 340),
        MinSize    = Vector2.new(280, 300),
        MaxSize    = Vector2.new(750, 880),
        ToggleSize = UDim2.fromOffset(38, 38),
        ToggleIcon = "rbxassetid://...",     -- opcional
        Banner     = "rbxassetid://...",     -- opcional
        BackgroundImage = "rbxassetid://...",-- opcional
        Resizable  = true,
        Theme = {
            Background = Color3.fromRGB(24, 24, 30),
            Secondary  = Color3.fromRGB(34, 34, 42),
            Accent     = Color3.fromRGB(88, 120, 255),
            Text       = Color3.fromRGB(240, 240, 245),
            SubText    = Color3.fromRGB(150, 150, 160),
            Stroke     = Color3.fromRGB(55, 55, 65),
            Close      = Color3.fromRGB(220, 70, 70),
        }
    })
--]]

local WindUI = {}

local Players          = game:GetService("Players")
local TweenService     = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local LP               = Players.LocalPlayer
local PlayerGui        = LP:WaitForChild("PlayerGui")

-- ==================== THEME BASE ====================
local DefaultTheme = {
    Background = Color3.fromRGB(24, 24, 30),
    Secondary  = Color3.fromRGB(34, 34, 42),
    Accent     = Color3.fromRGB(88, 120, 255),
    Text       = Color3.fromRGB(240, 240, 245),
    SubText    = Color3.fromRGB(150, 150, 160),
    Stroke     = Color3.fromRGB(55, 55, 65),
    Close      = Color3.fromRGB(220, 70, 70),
}

local function mergeTheme(custom)
    local t = {}
    for k, v in pairs(DefaultTheme) do t[k] = v end
    if custom then
        for k, v in pairs(custom) do t[k] = v end
    end
    return t
end

-- ==================== HELPERS ====================
local function new(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do inst[k] = v end
    return inst
end
local function corner(radius, parent)
    return new("UICorner", { CornerRadius = UDim.new(0, radius), Parent = parent })
end
local function stroke(color, thickness, parent)
    return new("UIStroke", { Color = color or DefaultTheme.Stroke, Thickness = thickness or 1, Parent = parent })
end

local function makeDraggable(frame, handle)
    handle = handle or frame
    local dragging, dragStart, startPos
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging  = true
            dragStart = input.Position
            startPos  = frame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

-- ==================== CREATE WINDOW ====================
function WindUI:CreateWindow(config)
    config = config or {}
    local Theme      = mergeTheme(config.Theme)
    local startSize  = config.Size       or UDim2.fromOffset(340, 340)
    local minSize    = config.MinSize    or Vector2.new(280, 300)
    local maxSize    = config.MaxSize    or Vector2.new(750, 880)
    local toggleSize = config.ToggleSize or UDim2.fromOffset(38, 38)
    local title      = config.Title      or "Wind UI"
    local bannerImg  = config.Banner
    local bgImg      = config.BackgroundImage
    local toggleIcon = config.ToggleIcon
    local resizable  = config.Resizable ~= false

    -- ScreenGui
    local gui = new("ScreenGui", {
        Name = "WindUI_" .. tostring(math.random(1000, 9999)),
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = PlayerGui,
    })

    ----------------------------------------------------------
    -- BOTÓN TOGGLE
    ----------------------------------------------------------
    local toggle = new("TextButton", {
        Name = "Toggle",
        Size = toggleSize,
        Position = UDim2.new(0, 20, 0.5, -toggleSize.Y.Offset / 2),
        BackgroundColor3 = Theme.Background,
        Text = "",
        AutoButtonColor = false,
        Parent = gui,
        ZIndex = 5,
    })
    corner(8, toggle)
    stroke(Theme.Stroke, 1, toggle)

    if toggleIcon then
        new("ImageLabel", {
            Size = UDim2.fromScale(0.6, 0.6),
            Position = UDim2.fromScale(0.5, 0.5),
            AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundTransparency = 1,
            Image = toggleIcon,
            Parent = toggle,
            ZIndex = 6,
        })
    end

    ----------------------------------------------------------
    -- VENTANA PRINCIPAL
    ----------------------------------------------------------
    local main = new("Frame", {
        Name = "Main",
        Size = startSize,
        Position = UDim2.new(0, 70, 0.5, -startSize.Y.Offset / 2),
        BackgroundColor3 = Theme.Background,
        Visible = false,
        ClipsDescendants = true,
        Parent = gui,
        ZIndex = 10,
    })
    corner(10, main)
    stroke(Theme.Stroke, 1, main)

    if bgImg and bgImg ~= "" then
        new("ImageLabel", {
            Name = "Bg",
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Image = bgImg,
            ImageTransparency = 0.5,
            ScaleType = Enum.ScaleType.Crop,
            ZIndex = 1,
            Parent = main,
        })
    end

    local bannerHeight   = (bannerImg and bannerImg ~= "") and 60 or 0
    local titleBarHeight = 30
    local tabBarHeight   = 32
    local contentY       = bannerHeight + titleBarHeight + tabBarHeight

    if bannerImg and bannerImg ~= "" then
        local banner = new("ImageLabel", {
            Name = "Banner",
            Size = UDim2.new(1, 0, 0, bannerHeight),
            Position = UDim2.new(0, 0, 0, 0),
            BackgroundTransparency = 1,
            Image = bannerImg,
            ScaleType = Enum.ScaleType.Crop,
            ZIndex = 2,
            Parent = main,
        })
        corner(10, banner)
    end

    -- Barra de título
    local titleBar = new("Frame", {
        Name = "TitleBar",
        Size = UDim2.new(1, 0, 0, titleBarHeight),
        Position = UDim2.new(0, 0, 0, bannerHeight),
        BackgroundTransparency = 1,
        Parent = main,
        ZIndex = 3,
    })

    new("TextLabel", {
        Size = UDim2.new(1, -40, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = Theme.Text,
        TextSize = 14,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = titleBar,
        ZIndex = 3,
    })

    local closeBtn = new("TextButton", {
        Size = UDim2.new(0, 22, 0, 22),
        Position = UDim2.new(1, -26, 0, 4),
        BackgroundColor3 = Theme.Close,
        Text = "×",
        TextColor3 = Color3.fromRGB(255, 255, 255),
        TextSize = 18,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false,
        Parent = titleBar,
        ZIndex = 3,
    })
    corner(6, closeBtn)

    makeDraggable(main, titleBar)

    -- Barra de tabs
    local tabBar = new("ScrollingFrame", {
        Name = "TabBar",
        Size = UDim2.new(1, -8, 0, tabBarHeight),
        Position = UDim2.new(0, 4, 0, bannerHeight + titleBarHeight),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.X,
        ScrollingDirection = Enum.ScrollingDirection.X,
        Parent = main,
        ZIndex = 3,
    })
    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        Parent = tabBar,
    })
    new("UIPadding", {
        PaddingLeft = UDim.new(0, 4),
        PaddingTop = UDim.new(0, 2),
        PaddingBottom = UDim.new(0, 2),
        Parent = tabBar,
    })

    -- Contenido
    local content = new("ScrollingFrame", {
        Name = "Content",
        Size = UDim2.new(1, -6, 1, -(contentY + 6)),
        Position = UDim2.new(0, 3, 0, contentY + 3),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Accent,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Parent = main,
        ZIndex = 3,
    })
    new("UIPadding", {
        PaddingLeft   = UDim.new(0, 2),
        PaddingRight  = UDim.new(0, 4),
        PaddingBottom = UDim.new(0, 6),
        Parent = content,
    })

    ----------------------------------------------------------
    -- HANDLE DE RESIZE (esquina inferior derecha)
    ----------------------------------------------------------
    if resizable then
        local resizeHandle = new("TextButton", {
            Name = "ResizeHandle",
            Size = UDim2.new(0, 16, 0, 16),
            Position = UDim2.new(1, -18, 1, -18),
            BackgroundColor3 = Theme.Secondary,
            Text = "◢",
            TextColor3 = Theme.Accent,
            TextSize = 12,
            Font = Enum.Font.GothamBold,
            AutoButtonColor = false,
            Parent = main,
            ZIndex = 20,
        })
        corner(4, resizeHandle)
        stroke(Theme.Accent, 1, resizeHandle)

        local resizing, resizeStart, startSizePx
        resizeHandle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                resizing    = true
                resizeStart = input.Position
                startSizePx = Vector2.new(main.AbsoluteSize.X, main.AbsoluteSize.Y)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if resizing and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - resizeStart
                local newW = math.clamp(startSizePx.X + delta.X, minSize.X, maxSize.X)
                local newH = math.clamp(startSizePx.Y + delta.Y, minSize.Y, maxSize.Y)
                main.Size = UDim2.fromOffset(newW, newH)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                resizing = false
            end
        end)
    end

    ----------------------------------------------------------
    -- ABRIR / CERRAR
    ----------------------------------------------------------
    toggle.MouseButton1Click:Connect(function()
        main.Visible = not main.Visible
    end)
    closeBtn.MouseButton1Click:Connect(function()
        main.Visible = false
    end)

    makeDraggable(toggle)

    ----------------------------------------------------------
    -- WINDOW OBJECT
    ----------------------------------------------------------
    local window = {}
    local tabs   = {}

    local function selectTab(target)
        for _, t in ipairs(tabs) do
            t.frame.Visible = false
            t.button.BackgroundColor3 = Theme.Secondary
            t.stroke.Color = Theme.Stroke
        end
        target.frame.Visible = true
        target.button.BackgroundColor3 = Theme.Accent
        target.stroke.Color = Theme.Accent
    end

    function window:Tab(tabTitle)
        local tabFrame = new("Frame", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Visible = true,
            Parent = content,
            ZIndex = 4,
        })
        new("UIListLayout", {
            Padding = UDim.new(0, 6),
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = tabFrame,
        })

        local tabBtn = new("TextButton", {
            Size = UDim2.new(0, 70, 1, -4),
            BackgroundColor3 = Theme.Secondary,
            Text = tabTitle,
            TextColor3 = Theme.Text,
            TextSize = 12,
            Font = Enum.Font.Gotham,
            AutoButtonColor = false,
            Parent = tabBar,
            ZIndex = 4,
        })
        corner(6, tabBtn)
        local tabStroke = stroke(Theme.Stroke, 1, tabBtn)

        local tabObj = { frame = tabFrame, button = tabBtn, stroke = tabStroke, name = tabTitle }

        tabBtn.MouseButton1Click:Connect(function() selectTab(tabObj) end)

        table.insert(tabs, tabObj)
        if #tabs == 1 then selectTab(tabObj) else tabFrame.Visible = false end

        function tabObj:Button(text, callback)
            local btn = new("TextButton", {
                Size = UDim2.new(1, 0, 0, 32),
                BackgroundColor3 = Theme.Secondary,
                Text = text,
                TextColor3 = Theme.Text,
                TextSize = 13,
                Font = Enum.Font.GothamMedium,
                AutoButtonColor = false,
                Parent = tabFrame,
                ZIndex = 4,
            })
            corner(6, btn)
            stroke(Theme.Stroke, 1, btn)
            btn.MouseEnter:Connect(function()
                TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = Theme.Accent }):Play()
            end)
            btn.MouseLeave:Connect(function()
                TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = Theme.Secondary }):Play()
            end)
            btn.MouseButton1Click:Connect(function()
                if callback then pcall(callback) end
            end)
            return btn
        end

        function tabObj:Label(text)
            return new("TextLabel", {
                Size = UDim2.new(1, 0, 0, 20),
                BackgroundTransparency = 1,
                Text = text,
                TextColor3 = Theme.SubText,
                TextSize = 12,
                Font = Enum.Font.Gotham,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = tabFrame,
                ZIndex = 4,
            })
        end

        function tabObj:Section(text)
            return new("TextLabel", {
                Size = UDim2.new(1, 0, 0, 22),
                BackgroundTransparency = 1,
                Text = text,
                TextColor3 = Theme.Accent,
                TextSize = 12,
                Font = Enum.Font.GothamBold,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = tabFrame,
                ZIndex = 4,
            })
        end

        function tabObj:Toggle(text, default, callback)
            local state = default or false
            local container = new("Frame", {
                Size = UDim2.new(1, 0, 0, 30),
                BackgroundColor3 = Theme.Secondary,
                Parent = tabFrame,
                ZIndex = 4,
            })
            corner(6, container)
            stroke(Theme.Stroke, 1, container)

            new("TextLabel", {
                Size = UDim2.new(1, -50, 1, 0),
                Position = UDim2.new(0, 10, 0, 0),
                BackgroundTransparency = 1,
                Text = text,
                TextColor3 = Theme.Text,
                TextSize = 12,
                Font = Enum.Font.Gotham,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = container,
                ZIndex = 4,
            })

            local toggleBtn = new("TextButton", {
                Size = UDim2.new(0, 36, 0, 18),
                Position = UDim2.new(1, -46, 0.5, -9),
                BackgroundColor3 = state and Theme.Accent or Color3.fromRGB(60, 60, 70),
                Text = "",
                AutoButtonColor = false,
                Parent = container,
                ZIndex = 4,
            })
            corner(9, toggleBtn)

            local knob = new("Frame", {
                Size = UDim2.new(0, 14, 0, 14),
                Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
                BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                Parent = toggleBtn,
                ZIndex = 5,
            })
            corner(7, knob)

            toggleBtn.MouseButton1Click:Connect(function()
                state = not state
                TweenService:Create(toggleBtn, TweenInfo.new(0.15), {
                    BackgroundColor3 = state and Theme.Accent or Color3.fromRGB(60, 60, 70)
                }):Play()
                TweenService:Create(knob, TweenInfo.new(0.15), {
                    Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
                }):Play()
                if callback then pcall(callback, state) end
            end)
            return toggleBtn
        end

        return tabObj
    end

    function window:Toggle() main.Visible = not main.Visible end
    function window:SelectTab(name)
        for _, t in ipairs(tabs) do
            if t.name == name then selectTab(t) return end
        end
    end
    function window:Destroy() gui:Destroy() end

    return window
end

return WindUI
