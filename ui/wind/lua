                        Tween(track, 0.16, { BackgroundColor3 = tc })
                    else
                        knob.Position = kp
                        track.BackgroundColor3 = tc
                    end
                end
                refresh(false)

                track.MouseButton1Click:Connect(function()
                    state = not state
                    if flag then SZK.Flags[flag] = state end
                    refresh(true)
                    callback(state)
                end)

                table.insert(Registered, { Type = "Element", Instance = row, Stroke = stroke, AccentBar = accentBar, Label = lbl, SubColor = track, State = function() return state end })

                local obj = {}
