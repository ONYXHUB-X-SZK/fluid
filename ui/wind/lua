local function setWindow(state)
    windowOpen = state
    if state then
        MainFrame.Visible = true
        MainFrame.Position = UDim2.new(savedPos.X.Scale, savedPos.X.Offset, savedPos.Y.Scale, savedPos.Y.Offset + 30)
        MainFrame.Size = UDim2.new(0, savedW * 0.9, 0, savedH * 0.9)
        tween(MainFrame, {
            Position = UDim2.new(savedPos.X.Scale, savedPos.X.Offset, savedPos.Y.Scale, savedPos.Y.Offset),
            Size = UDim2.new(0, savedW, 0, savedH),
        }, 0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        OpenBtn.Visible = false
    else
        tween(MainFrame, {
            Size = UDim2.new(0, savedW * 0.85, 0, savedH * 0.85),
        }, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        task.delay(0.2, function()
            MainFrame.Visible = false
            OpenBtn.Visible = true
        end)
    end
end

local btnDragging = false
local btnDragStart, btnStartPos = nil, nil
local btnMoved = false
local btnPressTime = 0

OpenBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        btnDragging = true
        btnMoved = false
        btnPressTime = tick()
        btnDragStart = input.Position
        btnStartPos = OpenBtn.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                btnDragging = false
                if not btnMoved and (tick() - btnPressTime) < 0.5 then
                    setWindow(true)
                end
                btnMoved = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if btnDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - btnDragStart
        if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then btnMoved = true end
        OpenBtn.Position = UDim2.new(
            btnStartPos.X.Scale, btnStartPos.X.Offset + delta.X,
            btnStartPos.Y.Scale, btnStartPos.Y.Offset + delta.Y
        )
    end
end)

