local function makeGripLine(size, pos)
    local line = Instance.new("Frame")
    line.Size = size
    line.Position = pos
    line.BackgroundColor3 = Theme.Accent
    line.BackgroundTransparency = 0.4
    line.BorderSizePixel = 0
    line.Active = false
    line.ZIndex = 10
    line.Parent = gripContainer
    addCorner(line, 1)
    return line
end

local gripL1 = makeGripLine(UDim2.new(0, 10, 0, 2), UDim2.new(1, -12, 1, -12))
local gripL2 = makeGripLine(UDim2.new(0, 7, 0, 2), UDim2.new(1, -12, 1, -8))
local gripL3 = makeGripLine(UDim2.new(0, 4, 0, 2), UDim2.new(1, -12, 1, -4))

local ResizeBtn = Instance.new("TextButton")
ResizeBtn.Size = UDim2.new(0, 22, 0, 22)
ResizeBtn.Position = UDim2.new(1, -22, 1, -22)
ResizeBtn.BackgroundTransparency = 1
ResizeBtn.Text = ""
ResizeBtn.AutoButtonColor = false
ResizeBtn.ZIndex = 11
ResizeBtn.Active = true
ResizeBtn.Parent = MainFrame

local resizeDragging = false
local resizeDragStart = nil
local resizeStartSize = nil

local function startResize(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        resizeDragging = true
        resizeDragStart = input.Position
        resizeStartSize = Vector2.new(MainFrame.AbsoluteSize.X, MainFrame.AbsoluteSize.Y)

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                resizeDragging = false
            end
        end)
    end
end

ResizeBtn.InputBegan:Connect(startResize)
ResizeHandle.InputBegan:Connect(startResize)

UserInputService.InputChanged:Connect(function(input)
    if not resizeDragging then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - resizeDragStart
        local newW = math.clamp(resizeStartSize.X + delta.X, MIN_W, MAX_W)
        local newH = math.clamp(resizeStartSize.Y + delta.Y, MIN_H, MAX_H)
        MainFrame.Size = UDim2.new(0, newW, 0, newH)
        savedW = newW
        savedH = newH
    end
end)

local function updateHover(state)
    if state then
        tween(gripL1, {BackgroundTransparency = 0}, 0.15)
        tween(gripL2, {BackgroundTransparency = 0}, 0.15)
        tween(gripL3, {BackgroundTransparency = 0}, 0.15)
    else
        if not resizeDragging then
            tween(gripL1, {BackgroundTransparency = 0.4}, 0.15)
            tween(gripL2, {BackgroundTransparency = 0.4}, 0.15)
            tween(gripL3, {BackgroundTransparency = 0.4}, 0.15)
        end
    end
end

ResizeBtn.MouseEnter:Connect(function() updateHover(true) end)
ResizeBtn.MouseLeave:Connect(function() updateHover(false) end)
ResizeHandle.MouseEnter:Connect(function() updateHover(true) end)
ResizeHandle.MouseLeave:Connect(function() updateHover(false) end)

local headerDragging = false
local headerDragStart = nil
local headerStartAbs = nil

local function isPointInFrame(point, frame)
    local p = frame.AbsolutePosition
    local s = frame.AbsoluteSize
    return point.X >= p.X and point.X <= p.X + s.X
       and point.Y >= p.Y and point.Y <= p.Y + s.Y
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if not MainFrame.Visible then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
    and input.UserInputType ~= Enum.UserInputType.Touch then return end

    local mp = input.Position

    if isPointInFrame(mp, CloseBtn) then return end

    if isPointInFrame(mp, Header) then
        headerDragging = true
        headerDragStart = Vector2.new(mp.X, mp.Y)
        headerStartAbs = Vector2.new(MainFrame.AbsolutePosition.X, MainFrame.AbsolutePosition.Y)

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                headerDragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not headerDragging then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - headerDragStart
        local newX = headerStartAbs.X + delta.X
        local newY = headerStartAbs.Y + delta.Y

        newX = math.clamp(newX, -MainFrame.AbsoluteSize.X + 40, screenW - 40)
        newY = math.clamp(newY, 0, screenH - 40)

        local newPos = UDim2.new(0, newX, 0, newY)
        MainFrame.Position = newPos
        savedPos = newPos
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        headerDragging = false
    end
end)

