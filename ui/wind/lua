--[[
    Wind UI v3 — estilo panel moderno
    Uso:
    local WindUI = loadstring(game:HttpGet("TU_URL"))()

    local Window = WindUI:CreateWindow({
        Title       = "Mi Panel",
        Version     = "v1.0",
        Logo        = "rbxassetid://...",     -- logo en la topbar
        ToggleIcon  = "rbxassetid://...",     -- ícono del botón flotante
        ToggleLabel = "Menu",                 -- texto del botón flotante
        Size        = UDim2.fromOffset(340, 340),
        MinSize     = Vector2.new(300, 320),
        MaxSize     = Vector2.new(750, 880),
        Banner      = "rbxassetid://...",     -- banner por defecto
        ConfirmClose= true,                   -- diálogo al cerrar
        Theme = { Accent = Color3.fromRGB(255,60,80) }
    })

    local Home = Window:Tab("Home", "rbxassetid://...")   -- icono opcional
    Home:Banner("rbxassetid://...")
    Home:UsersOnline("Users online", 270)
    Home:PillButton("Copiar Discord", function() setclipboard("...") end)
    Home:Setting("Editar posiciones", "Descripción larga...", false, function(s) end)
    Home:Action("Resetear", function() end)   -- fila con botón rojo (x)
--]]

local WindUI = {}

local Players          = game:GetService("Players")
local TweenService     = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local LP               = Players.LocalPlayer
local PlayerGui        = LP:WaitForChild("PlayerGui")

local DefaultTheme = {
    Background = Color3.fromRGB(20, 20, 24),
    Sidebar    = Color3.fromRGB(26, 26, 31),
    Secondary  = Color3.fromRGB(36, 36, 42),
    Accent     = Color3.fromRGB(230, 60, 80),
    Text       = Color3.fromRGB(240, 240, 245),
    SubText    = Color3.fromRGB(140, 140, 150),
    Stroke     = Color3.fromRGB(48, 48, 56),
    Close      = Color3.fromRGB(220, 60, 60),
    Online     = Color3.fromRGB(80, 220, 120),
    White      = Color3.fromRGB(250, 250, 252),
}

local function mergeTheme(custom)
    local t = {}
    for k, v in pairs(DefaultTheme) do t[k] = v end
    if custom then for k, v in pairs(custom) do t[k] = v end end
    return t
end

local function new(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do inst[k] = v end
    return inst
end
local function corner(r, p) return new("UICorner", { CornerRadius = UDim.new(0, r), Parent = p }) end
local function stroke(c, t, p) return new("UIStroke", { Color = c, Thickness = t or 1, Parent = p }) end

local function draggable(frame, handle)
    handle = handle or frame
    local dragging, dragStart, startPos
    handle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging, dragStart, startPos = true, i.Position, frame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

-- ================= CREATE WINDOW =================
function WindUI:CreateWindow(cfg)
    cfg = cfg or {}
    local Theme      = mergeTheme(cfg.Theme)
    local startSize  = cfg.Size       or UDim2.fromOffset(340, 340)
    local minSize    = cfg.MinSize    or Vector2.new(300, 320)
    local maxSize    = cfg.MaxSize    or Vector2.new(750, 880)
    local title      = cfg.Title      or "Panel"
    local version    = cfg.Version    or "v1.0"
    local logoImg    = cfg.Logo
    local toggleIcon = cfg.ToggleIcon
    local toggleLbl  = cfg.ToggleLabel or "Menu"
    local confirmClose = cfg.ConfirmClose ~= false
    local defBanner  = cfg.Banner

    local gui = new("ScreenGui", {
        Name = "WindUI_" .. tostring(math.random(1000, 9999)),
        ResetOnSpawn = false, IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = PlayerGui,
    })

    ------------------------------------------------------
    -- BOTÓN FLOTANTE (pill arrastrable)
    ------------------------------------------------------
    local floatBtn = new("TextButton", {
        Name = "FloatToggle",
        Size = UDim2.fromOffset(120, 38),
        Position = UDim2.new(0, 20, 0, 20),
        BackgroundColor3 = Theme.Background,
        Text = "", AutoButtonColor = false,
        Parent = gui, ZIndex = 5,
    })
    corner(19, floatBtn); stroke(Theme.Stroke, 1, floatBtn)

    local iconBox = new("Frame", {
        Size = UDim2.fromOffset(30, 30),
        Position = UDim2.new(0, 4, 0.5, -15),
        BackgroundColor3 = Theme.Secondary,
        Parent = floatBtn, ZIndex = 6,
    })
    corner(8, iconBox)
    if toggleIcon then
        new("ImageLabel", {
            Size = UDim2.fromScale(0.65, 0.65),
            Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundTransparency = 1, Image = toggleIcon,
            Parent = iconBox, ZIndex = 7,
        })
    end
    new("TextLabel", {
        Size = UDim2.new(1, -44, 1, 0),
        Position = UDim2.new(0, 40, 0, 0),
        BackgroundTransparency = 1, Text = toggleLbl,
        TextColor3 = Theme.Text, TextSize = 14, Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = floatBtn, ZIndex = 6,
    })

    ------------------------------------------------------
    -- VENTANA PRINCIPAL
    ------------------------------------------------------
    local main = new("Frame", {
        Name = "Main", Size = startSize,
        Position = UDim2.new(0, 70, 0.5, -startSize.Y.Offset / 2),
        BackgroundColor3 = Theme.Background,
        Visible = false, ClipsDescendants = true,
        Parent = gui, ZIndex = 10,
    })
    corner(10, main); stroke(Theme.Stroke, 1, main)

    -- TOPBAR
    local topH = 40
    local topBar = new("Frame", {
        Size = UDim2.new(1, 0, 0, topH), BackgroundColor3 = Theme.Background,
        Parent = main, ZIndex = 3,
    })
    -- logo
    local logoBox = new("Frame", {
        Size = UDim2.fromOffset(24, 24), Position = UDim2.new(0, 10, 0.5, -12),
        BackgroundColor3 = Theme.Secondary, Parent = topBar, ZIndex = 4,
    })
    corner(6, logoBox)
    if logoImg then
        new("ImageLabel", {
            Size = UDim2.fromScale(0.75, 0.75),
            Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundTransparency = 1, Image = logoImg,
            Parent = logoBox, ZIndex = 5,
        })
    end
    new("TextLabel", {
        Size = UDim2.new(0, 120, 1, 0), Position = UDim2.new(0, 42, 0, 0),
        BackgroundTransparency = 1, Text = title,
        TextColor3 = Theme.Text, TextSize = 14, Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = topBar, ZIndex = 4,
    })
    -- badge versión
    local badge = new("Frame", {
        Size = UDim2.fromOffset(80, 22), Position = UDim2.new(0, 120, 0.5, -11),
        BackgroundColor3 = Theme.Accent, Parent = topBar, ZIndex = 4,
    })
    corner(6, badge)
    new("TextLabel", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
        Text = version, TextColor3 = Color3.fromRGB(255, 255, 255),
        TextSize = 12, Font = Enum.Font.GothamBold,
        Parent = badge, ZIndex = 5,
    })

    -- botones topbar
    local function topBtn(x, glyph)
        local b = new("TextButton", {
            Size = UDim2.fromOffset(24, 24),
            Position = UDim2.new(1, x, 0.5, -12),
            BackgroundTransparency = 1, Text = glyph,
            TextColor3 = Theme.SubText, TextSize = 16,
            Font = Enum.Font.GothamBold, AutoButtonColor = false,
            Parent = topBar, ZIndex = 4,
        })
        return b
    end
    local minBtn = topBtn(-84, "—")
    local maxBtn = topBtn(-56, "⛶")
    local closeBtn = topBtn(-28, "✕")
    closeBtn.TextColor3 = Theme.Close

    ------------------------------------------------------
    -- SIDEBAR (tabs izquierda)
    ------------------------------------------------------
    local sideW = 118
    local sidebar = new("ScrollingFrame", {
        Name = "Sidebar",
        Size = UDim2.new(0, sideW, 1, -(topH + 6)),
        Position = UDim2.new(0, 6, 0, topH + 3),
        BackgroundColor3 = Theme.Sidebar,
        BorderSizePixel = 0, ScrollBarThickness = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Parent = main, ZIndex = 3,
    })
    corner(8, sidebar)
    new("UIListLayout", {
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = sidebar,
    })
    new("UIPadding", {
        PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6),
        PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6),
        Parent = sidebar,
    })

    ------------------------------------------------------
    -- CONTENIDO (derecha)
    ------------------------------------------------------
    local contentX = sideW + 12
    local contentW = 1
    local content = new("ScrollingFrame", {
        Name = "Content",
        Size = UDim2.new(contentW, -(contentX + 6), 1, -(topH + 6)),
        Position = UDim2.new(0, contentX, 0, topH + 3),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.Accent,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Parent = main, ZIndex = 3,
    })
    new("UIPadding", {
        PaddingRight = UDim.new(0, 6), PaddingBottom = UDim.new(0, 8),
        Parent = content,
    })

    ------------------------------------------------------
    -- HANDLE RESIZE
    ------------------------------------------------------
    local resize = new("TextButton", {
        Size = UDim2.fromOffset(16, 16),
        Position = UDim2.new(1, -18, 1, -18),
        BackgroundColor3 = Theme.Secondary, Text = "◢",
        TextColor3 = Theme.Accent, TextSize = 12, Font = Enum.Font.GothamBold,
        AutoButtonColor = false, Parent = main, ZIndex = 20,
    })
    corner(4, resize); stroke(Theme.Accent, 1, resize)
    local rs, rStart, sSize
    resize.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            rs = true; rStart = i.Position; sSize = Vector2.new(main.AbsoluteSize.X, main.AbsoluteSize.Y)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if rs and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - rStart
            local w = math.clamp(sSize.X + d.X, minSize.X, maxSize.X)
            local h = math.clamp(sSize.Y + d.Y, minSize.Y, maxSize.Y)
            main.Size = UDim2.fromOffset(w, h)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then rs = false end
    end)

    ------------------------------------------------------
    -- DIÁLOGO CONFIRMAR CERRAR
    ------------------------------------------------------
    local overlay = new("TextButton", {
        Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
        BackgroundTransparency = 0.5, Text = "", AutoButtonColor = false,
        Visible = false, Parent = gui, ZIndex = 50,
    })
    local dialog = new("Frame", {
        Size = UDim2.fromOffset(280, 160),
        Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Theme.Background, Parent = overlay, ZIndex = 51,
    })
    corner(10, dialog); stroke(Theme.Stroke, 1, dialog)

    new("TextLabel", {
        Size = UDim2.new(1, -20, 0, 24), Position = UDim2.new(0, 12, 0, 12),
        BackgroundTransparency = 1, Text = "Close Window",
        TextColor3 = Theme.Text, TextSize = 14, Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = dialog, ZIndex = 52,
    })
    new("TextLabel", {
        Size = UDim2.new(1, -24, 0, 50), Position = UDim2.new(0, 12, 0, 40),
        BackgroundTransparency = 1, TextWrapped = true,
        Text = "Do you want to close this window? You will not be able to open it again.",
        TextColor3 = Theme.SubText, TextSize = 12, Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
        Parent = dialog, ZIndex = 52,
    })

    local cancel = new("TextButton", {
        Size = UDim2.fromOffset(110, 32), Position = UDim2.new(0, 12, 1, -44),
        BackgroundColor3 = Theme.Accent, Text = "Cancel",
        TextColor3 = Color3.fromRGB(255,255,255), TextSize = 13, Font = Enum.Font.GothamBold,
        AutoButtonColor = false, Parent = dialog, ZIndex = 52,
    })
    corner(8, cancel)
    local closeConfirm = new("TextButton", {
        Size = UDim2.fromOffset(120, 32), Position = UDim2.new(1, -132, 1, -44),
        BackgroundColor3 = Theme.Secondary, Text = "Close Window",
        TextColor3 = Theme.Text, TextSize = 13, Font = Enum.Font.GothamBold,
        AutoButtonColor = false, Parent = dialog, ZIndex = 52,
    })
    corner(8, closeConfirm); stroke(Theme.Stroke, 1, closeConfirm)

    ------------------------------------------------------
    -- LÓGICA ABRIR / CERRAR
    ------------------------------------------------------
    local function hideMain() main.Visible = false end
    local function showMain() main.Visible = true end
    local function tryClose()
        if confirmClose then overlay.Visible = true else gui:Destroy() end
    end

    floatBtn.MouseButton1Click:Connect(function()
        main.Visible = not main.Visible
    end)
    minBtn.MouseButton1Click:Connect(hideMain)
    closeBtn.MouseButton1Click:Connect(tryClose)
    cancel.MouseButton1Click:Connect(function() overlay.Visible = false end)
    closeConfirm.MouseButton1Click:Connect(function() gui:Destroy() end)

    maxBtn.MouseButton1Click:Connect(function()
        local cur = main.AbsoluteSize
        if cur.X < maxSize.X - 20 then
            main.Size = UDim2.fromOffset(maxSize.X, maxSize.Y)
        else
            main.Size = startSize
        end
    end)

    draggable(main, topBar)
    draggable(floatBtn, floatBtn)

    ------------------------------------------------------
    -- WINDOW OBJECT
    ------------------------------------------------------
    local window = {}
    local tabs = {}
    local function selectTab(t)
        for _, x in ipairs(tabs) do
            x.frame.Visible = false
            x.btn.BackgroundColor3 = Theme.Sidebar
        end
        t.frame.Visible = true
        t.btn.BackgroundColor3 = Theme.Secondary
    end

    function window:Tab(name, icon)
        local tabFrame = new("Frame", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1, Visible = false,
            Parent = content, ZIndex = 4,
        })
        new("UIListLayout", {
            Padding = UDim.new(0, 8),
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = tabFrame,
        })

        local btn = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Theme.Sidebar,
            Text = "", AutoButtonColor = false,
            Parent = sidebar, ZIndex = 4,
        })
        corner(6, btn)
        if icon then
            new("ImageLabel", {
                Size = UDim2.fromOffset(14, 14), Position = UDim2.new(0, 8, 0.5, -7),
                BackgroundTransparency = 1, Image = icon,
                Parent = btn, ZIndex = 5,
            })
            new("TextLabel", {
                Size = UDim2.new(1, -28, 1, 0), Position = UDim2.new(0, 26, 0, 0),
                BackgroundTransparency = 1, Text = name,
                TextColor3 = Theme.Text, TextSize = 12, Font = Enum.Font.GothamMedium,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = btn, ZIndex = 5,
            })
        else
            new("TextLabel", {
                Size = UDim2.new(1, -16, 1, 0), Position = UDim2.new(0, 8, 0, 0),
                BackgroundTransparency = 1, Text = name,
                TextColor3 = Theme.Text, TextSize = 12, Font = Enum.Font.GothamMedium,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = btn, ZIndex = 5,
            })
        end

        local tab = { frame = tabFrame, btn = btn, name = name }
        btn.MouseButton1Click:Connect(function() selectTab(tab) end)
        table.insert(tabs, tab)
        if #tabs == 1 then selectTab(tab) end

        -------------------------------------------
        -- ELEMENTOS
        -------------------------------------------
        function tab:Banner(assetId, height)
            if not assetId or assetId == "" then return end
            local b = new("ImageLabel", {
                Size = UDim2.new(1, 0, 0, height or 70),
                BackgroundColor3 = Theme.Secondary, BackgroundTransparency = 0,
                Image = assetId, ScaleType = Enum.ScaleType.Crop,
                Parent = tabFrame, ZIndex = 4,
            })
            corner(8, b); stroke(Theme.Stroke, 1, b)
            return b
        end

        function tab:UsersOnline(label, count)
            local wrap = new("Frame", {
                Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1,
                Parent = tabFrame, ZIndex = 4,
            })
            new("Frame", {
                Size = UDim2.fromOffset(10, 10), Position = UDim2.new(0, 2, 0, 4),
                BackgroundColor3 = Theme.Online, Parent = wrap, ZIndex = 5,
            })
            local dot = wrap:FindFirstChildOfClass("Frame"); if dot then corner(5, dot) end
            new("TextLabel", {
                Size = UDim2.new(1, -20, 0, 16), Position = UDim2.new(0, 20, 0, 0),
                BackgroundTransparency = 1, Text = label or "Users online",
                TextColor3 = Theme.Text, TextSize = 13, Font = Enum.Font.GothamBold,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = wrap, ZIndex = 5,
            })
            new("TextLabel", {
                Size = UDim2.new(1, -20, 0, 16), Position = UDim2.new(0, 20, 0, 18),
                BackgroundTransparency = 1, Text = tostring(count or 0) .. " people connected",
                TextColor3 = Theme.SubText, TextSize = 12, Font = Enum.Font.Gotham,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = wrap, ZIndex = 5,
            })
            return wrap
        end

        function tab:PillButton(text, callback)
            local b = new("TextButton", {
                Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = Theme.White,
                Text = text, TextColor3 = Color3.fromRGB(20,20,24),
                TextSize = 13, Font = Enum.Font.GothamBold, AutoButtonColor = false,
                Parent = tabFrame, ZIndex = 4,
            })
            corner(17, b)
            b.MouseButton1Click:Connect(function() if callback then pcall(callback) end end)
            return b
        end

        function tab:Setting(title, desc, default, callback)
            local state = default or false
            local wrap = new("Frame", {
                Size = UDim2.new(1, 0, 0, 60), BackgroundColor3 = Theme.Secondary,
                Parent = tabFrame, ZIndex = 4,
            })
            corner(8, wrap); stroke(Theme.Stroke, 1, wrap)

            new("TextLabel", {
                Size = UDim2.new(1, -60, 0, 18), Position = UDim2.new(0, 10, 0, 8),
                BackgroundTransparency = 1, Text = title,
                TextColor3 = Theme.Text, TextSize = 13, Font = Enum.Font.GothamBold,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = wrap, ZIndex = 5,
            })
            new("TextLabel", {
                Size = UDim2.new(1, -20, 0, 30), Position = UDim2.new(0, 10, 0, 26),
                BackgroundTransparency = 1, TextWrapped = true, Text = desc or "",
                TextColor3 = Theme.SubText, TextSize = 11, Font = Enum.Font.Gotham,
                TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
                Parent = wrap, ZIndex = 5,
            })

            local tg = new("TextButton", {
                Size = UDim2.fromOffset(34, 18), Position = UDim2.new(1, -44, 0, 12),
                BackgroundColor3 = state and Theme.Accent or Color3.fromRGB(70,70,80),
                Text = "", AutoButtonColor = false,
                Parent = wrap, ZIndex = 5,
            })
            corner(9, tg)
            local knob = new("Frame", {
                Size = UDim2.fromOffset(14, 14),
                Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
                BackgroundColor3 = Theme.White,
                Parent = tg, ZIndex = 6,
            })
            corner(7, knob)
            tg.MouseButton1Click:Connect(function()
                state = not state
                TweenService:Create(tg, TweenInfo.new(0.15), {
                    BackgroundColor3 = state and Theme.Accent or Color3.fromRGB(70,70,80)
                }):Play()
                TweenService:Create(knob, TweenInfo.new(0.15), {
                    Position = state and UDim2.new(1,-16,0.5,-7) or UDim2.new(0,2,0.5,-7)
                }):Play()
                if callback then pcall(callback, state) end
            end)
            return tg
        end

        function tab:Action(title, callback, color)
            local wrap = new("Frame", {
                Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = Theme.Secondary,
                Parent = tabFrame, ZIndex = 4,
            })
            corner(8, wrap); stroke(Theme.Stroke, 1, wrap)

            new("TextLabel", {
                Size = UDim2.new(1, -40, 1, 0), Position = UDim2.new(0, 10, 0, 0),
                BackgroundTransparency = 1, Text = title,
                TextColor3 = Theme.Text, TextSize = 13, Font = Enum.Font.Gotham,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = wrap, ZIndex = 5,
            })
            local b = new("TextButton", {
                Size = UDim2.fromOffset(24, 24), Position = UDim2.new(1, -32, 0.5, -12),
                BackgroundTransparency = 1, Text = "✕",
                TextColor3 = color or Theme.Close, TextSize = 14,
                Font = Enum.Font.GothamBold, AutoButtonColor = false,
                Parent = wrap, ZIndex = 5,
            })
            b.MouseButton1Click:Connect(function() if callback then pcall(callback) end end)
            return b
        end

        function tab:Label(text)
            return new("TextLabel", {
                Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1,
                Text = text, TextColor3 = Theme.SubText, TextSize = 12, Font = Enum.Font.Gotham,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = tabFrame, ZIndex = 4,
            })
        end

        function tab:Section(text)
            return new("TextLabel", {
                Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1,
                Text = text, TextColor3 = Theme.Accent, TextSize = 12, Font = Enum.Font.GothamBold,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = tabFrame, ZIndex = 4,
            })
        end

        return tab
    end

    function window:Toggle() main.Visible = not main.Visible end
    function window:Destroy() gui:Destroy() end
    function window:SelectTab(n)
        for _, t in ipairs(tabs) do if t.name == n then selectTab(t) return end end
    end

    return window
end

return WindUI
